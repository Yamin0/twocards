NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Acompte en ligne (Twocards, LLC) — côté serveur uniquement
# Stripe → Développeurs → Clés API (sk_test_… pour les essais)
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe → Développeurs → Webhooks → endpoint /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Supabase → Project Settings → API → service_role (jamais côté client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
