NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# La clé publique du projet. Le tableau de bord Supabase la nomme désormais
# « publishable » (sb_publishable_…) ; l'ancien nom « anon » (un JWT eyJ…)
# reste valide. Les deux variables sont acceptées, ANON_KEY en premier.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
